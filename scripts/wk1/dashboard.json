{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 24, "height": 6,
      "properties": {
        "title": "Lambda (wk1-todo-api)",
        "view": "timeSeries",
        "region": "ap-northeast-1",
        "period": 300,
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "wk1-todo-api", { "stat": "Sum" }],
          ["AWS/Lambda", "Errors", "FunctionName", "wk1-todo-api", { "stat": "Sum" }],
          ["AWS/Lambda", "Throttles", "FunctionName", "wk1-todo-api", { "stat": "Sum" }],
          ["AWS/Lambda", "Duration", "FunctionName", "wk1-todo-api", { "stat": "Average", "yAxis": "right" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 24, "height": 6,
      "properties": {
        "title": "DynamoDB (Todos)",
        "view": "timeSeries",
        "region": "ap-northeast-1",
        "period": 300,
        "metrics": [
          ["AWS/DynamoDB", "ConsumedReadCapacityUnits", "TableName", "Todos", { "stat": "Sum" }],
          ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "Todos", { "stat": "Sum" }],
          ["AWS/DynamoDB", "ThrottledRequests", "TableName", "Todos", { "stat": "Sum", "yAxis": "right" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 12, "width": 24, "height": 6,
      "properties": {
        "title": "API Gateway (wk1-todo-http-api)",
        "view": "timeSeries",
        "region": "ap-northeast-1",
        "period": 300,
        "metrics": [
          ["AWS/ApiGateway", "Count", "ApiId", "{{API_ID}}", { "stat": "Sum" }],
          ["AWS/ApiGateway", "4xx", "ApiId", "{{API_ID}}", { "stat": "Sum" }],
          ["AWS/ApiGateway", "5xx", "ApiId", "{{API_ID}}", { "stat": "Sum" }],
          ["AWS/ApiGateway", "Latency", "ApiId", "{{API_ID}}", { "stat": "Average", "yAxis": "right" }]
        ]
      }
    }
  ]
}
